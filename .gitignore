# --- SurGE data ---
# corpus.json / surveys.json / queries.json are multi-GB downloads (see SETTING.md §3)
data/

# Evaluation results written next to a baseline's output dir.
# Deliberately narrow: baselines/*/output/<survey_id>/*.json is committed data.
baselines/*/output/log.json
baselines/*/output/*.log

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtualenvs (conda envs live outside the repo)
.venv/
venv/
env/
ENV/

