# SurGE LLM-as-Judge 설정 예시.
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 .gitignore 로 커밋되지 않습니다.
#
#   cp .env.example .env
#
# 여기 설정은 Structure_Quality(SQS) 와 Logic(CQS) 두 지표에만 쓰입니다.
# 나머지 5개 지표(Coverage / SH-Recall / Relevance-*)는 API 없이 동작합니다.
#
# 우선순위: CLI 인자(--api_key, --base_url, --model) > 아래 환경변수 > 기본값

# --- OpenRouter 를 쓰는 경우 ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SURGE_JUDGE_MODEL=openai/gpt-4o

# --- OpenAI 를 직접 쓰는 경우 (BASE_URL 은 비워둘 것) ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SURGE_JUDGE_MODEL=gpt-4o

# --- 재시도 / 로깅 ---
# 판정 응답이 '0'~'5' 한 글자와 일치하지 않을 때 다시 물어보는 횟수 (기본 5).
# 이 상한에 걸리면 해당 판정을 포기하고 ERROR 로그를 남긴다.
# 형식을 못 맞추는 모델(예: 설명을 덧붙이거나 reasoning 토큰만 내는 모델)에서
# 호출이 무한히 늘어나는 것을 막아준다.
SURGE_MAX_RETRIES=5

# DEBUG | INFO | WARNING | ERROR (기본 INFO)
SURGE_LOG_LEVEL=INFO
# 로그는 항상 stderr 로 나가고, 아래를 지정하면 파일에도 함께 기록한다.
# SURGE_LOG_FILE=logs/eval.log

# 주의: 논문 Table 4 의 SQS/CQS 는 gpt-4o 로 산출된 값입니다.
# 다른 판정 모델을 쓰면 논문 수치와 직접 비교할 수 없습니다 (SETTING.md §9.2, §10 참조).
